{
	admin off
}

# aprond's routes, from Server::handler in src/server/server.rs. Everything
# else is the web client.
:8080 {
	@aprond path /ws /healthz /write/* /files/* /live/* /emoji/* /.well-known/apple-app-site-association /.well-known/webauthn
	handle @aprond {
		# Live text reads stream as they arrive (/live/), so nothing waits
		# to be flushed.
		reverse_proxy aprond:8080 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:8080
	}
}
